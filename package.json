{
  "name": "@handrail/ai",
  "version": "0.1.5",
  "description": "Provider-neutral TypeScript primitives and runtime tooling for building AI applications with Handrail.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "check:public-surface": "node scripts/check-provider-public-surface.mjs",
    "check:vite-consumer": "npm run build && node scripts/check-vite-consumer.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run --json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.17.2",
    "eslint": "10.9.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
