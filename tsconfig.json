{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@handrail/ai": ["./src/index.ts"],
      "@handrail/ai/browser": ["./src/browser/index.ts"],
      "@handrail/ai/react": ["./src/react/index.ts"],
      "@handrail/ai/client": ["./src/client/index.ts"],
      "@handrail/ai/react/headless": ["./src/react-headless/index.ts"],
      "@handrail/ai/react/styled": ["./src/react-styled/index.tsx"],
      "@handrail/ai/server/application-gateway": ["./src/server/application-gateway.ts"],
      "@handrail/ai/server/assistant-context": ["./src/server/assistant-context.ts"],
      "@handrail/ai/server/managed": ["./src/server/managed.ts"],
      "@handrail/ai/providers/openai": ["./src/providers/openai.ts"],
      "@handrail/ai/providers/anthropic": ["./src/providers/anthropic.ts"],
      "@handrail/ai/providers/gemini": ["./src/providers/gemini.ts"],
      "@handrail/ai/providers/xai": ["./src/providers/xai.ts"],
      "@handrail/ai/adapters/spartan-aegis": ["./src/adapters/spartan-aegis.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest.config.ts"
  ]
}
